# Copy this file to .env and change the keys. .env is git-ignored.
# Format: key:user:role, comma-separated. Roles: analyst, admin.
# Make real keys long and random, e.g. in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=change-me-analyst-key:analyst1:analyst,change-me-admin-key:admin1:admin

# Phase 5b: set to false to keep IPs visible in the audit log.
PII_REDACT_IPS=true
