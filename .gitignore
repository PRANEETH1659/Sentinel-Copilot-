# Virtual environment - just installed packages, not your code.
# Anyone cloning this repo re-creates it with `pip install -r requirements.txt`.
venv/
env/
.venv/

# Python cache/bytecode
__pycache__/
*.pyc

# Secrets/local overrides, if you ever add a .env file
.env

# Editor/OS clutter
.vscode/
.idea/
.DS_Store

# Scratch curl payloads
body.json
.pytest_cache/
.ruff_cache/
eval/results/
